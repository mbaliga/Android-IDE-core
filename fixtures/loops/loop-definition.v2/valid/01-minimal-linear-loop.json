      { "nodeId": "n1", "onFailure": "FAILED_SAFE" },
      { "nodeId": "n2", "onFailure": "FAILED_SAFE" },
      { "nodeId": "n3", "onFailure": "FAILED_SAFE" }
    ]
  },
  "provenance": { "sourceLocation": "phone-authored", "projectRevision": "n/a", "initiatingPrincipal": "user:demo" },
  "licenseRef": { "spdxId": "Apache-2.0" }
