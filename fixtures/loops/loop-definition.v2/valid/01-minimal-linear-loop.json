      "outputPorts": [{ "portId": "out", "schemaRef": null, "mediaType": "text/plain" }],
      "implementation": { "kind": "CAPABILITY_BINDING", "capabilityId": "fb.repo.read" },
      "requestedCapabilities": ["fb.repo.read"],
      "authorityClass": "READ",
      "preferredExecutionTargets": ["LOCAL_ANDROID"],
      "permittedExecutionTargets": ["LOCAL_ANDROID"],
      "timeoutPolicy": { "timeoutSeconds": 30, "onTimeout": "FAIL_SAFE" },
      "retryPolicy": { "maxRetries": 2, "backoff": "FIXED", "baseDelaySeconds": 1 },
      "idempotencyMode": "PURE",
      "compensation": { "compensable": false, "nonCompensabilityAcknowledged": true },
      "verificationRequirements": { "requiredForSuccess": false, "verifierIds": [] },
      "sideEffectClass": "NONE",
      "onFailureTerminalState": "FAILED_SAFE",
      "explanation": "Reads file content from the bound repository capability."
    },
    {
      "nodeId": "n2",
      "category": "MODEL_INFERENCE",
      "inputPorts": [{ "portId": "in", "mediaType": "text/plain" }],
      "outputPorts": [{ "portId": "out", "mediaType": "text/plain" }],
      "implementation": { "kind": "TYPED_SLOT", "slotId": "summarizer-model" },
      "requestedCapabilities": ["fb.model.local_inference"],
      "authorityClass": "EXECUTE_REVERSIBLE",
      "preferredExecutionTargets": ["LOCAL_ANDROID"],
      "permittedExecutionTargets": ["LOCAL_ANDROID"],
      "timeoutPolicy": { "timeoutSeconds": 120, "onTimeout": "FAIL_SAFE" },
      "retryPolicy": { "maxRetries": 1, "backoff": "NONE" },
      "idempotencyMode": "NOT_IDEMPOTENT",
      "compensation": { "compensable": false, "nonCompensabilityAcknowledged": true },
      "verificationRequirements": { "requiredForSuccess": false, "verifierIds": [] },
      "sideEffectClass": "NONE",
      "onFailureTerminalState": "FAILED_SAFE",
      "requestedModelCapabilityTags": ["text-generation", "on-device-residency"],
      "explanation": "Summarizes the file content using a locally bound model."
    },
    {
      "nodeId": "n3",
      "category": "TYPED_TOOL",
      "inputPorts": [{ "portId": "in", "mediaType": "text/plain" }],
      "outputPorts": [{ "portId": "out", "mediaType": "application/json" }],
      "implementation": { "kind": "CAPABILITY_BINDING", "capabilityId": "fb.repo.write_draft" },
      "requestedCapabilities": ["fb.repo.write_draft"],
      "authorityClass": "MODIFY_DRAFT",
      "preferredExecutionTargets": ["LOCAL_ANDROID"],
      "permittedExecutionTargets": ["LOCAL_ANDROID"],
      "timeoutPolicy": { "timeoutSeconds": 15, "onTimeout": "FAIL_SAFE" },
      "retryPolicy": { "maxRetries": 2, "backoff": "FIXED", "baseDelaySeconds": 1 },
      "idempotencyMode": "IDEMPOTENT_WITH_KEY",
      "idempotencyKeyStrategy": "loopRunId+nodeId",
      "compensation": { "compensable": true, "compensationDescription": "Revert the draft buffer write via DocumentBuffer undo." },
      "verificationRequirements": { "requiredForSuccess": false, "verifierIds": [] },
      "sideEffectClass": "REVERSIBLE_LOCAL",
      "onFailureTerminalState": "FAILED_SAFE",
      "explanation": "Writes the generated summary into an uncommitted draft buffer."
    }
