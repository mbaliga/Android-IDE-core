  "inputSchema": { "location": "INLINE", "inlineSchema": { "type": "object", "properties": { "path": { "type": "string" } }, "required": ["path"] } },
  "outputSchema": { "location": "INLINE", "inlineSchema": { "type": "object", "properties": { "summary": { "type": "string" } }, "required": ["summary"] } },
  "startNodeId": "n1",
  "terminalNodeIds": ["n3"],
  "nodes": [
    {
      "nodeId": "n1",
      "category": "DETERMINISTIC_TRANSFORMATION",
