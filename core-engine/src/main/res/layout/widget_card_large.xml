<?xml version="1.0" encoding="utf-8"?>
<!-- Card template, large (2x3 and up): adds detail and an explicit action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/header_title"
            style="@style/FonebrewWidgetText.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/header_meta"
            style="@style/FonebrewWidgetText.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>
    <!-- Text takes what is left and is what gets cut; the action below is never pushed off. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/card_title"
            style="@style/FonebrewWidgetText.Value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:maxLines="2" />
        <TextView
            android:id="@+id/card_body"
            style="@style/FonebrewWidgetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2" />
        <TextView
            android:id="@+id/card_detail"
            style="@style/FonebrewWidgetText.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2" />
    </LinearLayout>
    <TextView
        android:id="@+id/card_action"
        style="@style/FonebrewWidgetPad.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:autoSizeTextType="none"
        android:maxLines="1" />
</LinearLayout>
