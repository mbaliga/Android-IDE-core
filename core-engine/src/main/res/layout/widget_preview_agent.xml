<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview: sample content only, never shown on a home screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/header_title"
            style="@style/FonebrewWidgetText.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_agent_label" />
        <TextView
            android:id="@+id/header_meta"
            style="@style/FonebrewWidgetText.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_as_of"
            android:layout_marginStart="8dp" />
    </LinearLayout>
    <TextView
        style="@style/FonebrewWidgetText.Value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_agent_title"
        android:textSize="16sp" />
    <TextView
        style="@style/FonebrewWidgetText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_agent_ready_body"
        android:layout_marginTop="4dp"
        android:maxLines="2" />
</LinearLayout>
