<?xml version="1.0" encoding="utf-8"?>
<!-- See ic_launcher.xml for the <monochrome> rationale (Android 13+ themed icons,
     additive, owner-verified rendering only). Kept in lockstep with the non-round
     variant so both launcher shapes theme the same way. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/brand_logo" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
