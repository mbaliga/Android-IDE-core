<?xml version="1.0" encoding="utf-8"?>
<!-- A widget pad (one action): inset surface, inner corner radius, pressed ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/widget_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_inset" />
            <stroke android:width="1dp" android:color="@color/widget_outline" />
            <corners android:radius="@dimen/widget_inner_radius" />
        </shape>
    </item>
</ripple>
