<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Egress is sanctioned for exactly two purposes (handoff §0): user-initiated
      model downloads, and opt-in cloud provider turns. Cloud is never a hidden
      default — the app defaults to on-device models, and every cloud provider is
      surfaced as a "watched object". No analytics, no telemetry.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- User-granted bridge into Termux RUN_COMMAND; Fonebrew never assumes it is granted. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- Signature-scoped bridge: Fylz owns all user-file and Kindle-storage operations. -->
    <uses-permission android:name="io.github.mbaliga.fylz.permission.OPERATE" />
    <!-- Keep the process alive while a local model loads/generates or downloads. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- §7 heavy tiers (overlay bubble, screen capture) live in the FULL flavor's
         manifest overlay — the play build ships without those permissions. -->

    <!--
      No android:name/icon/theme/label here — this is a library manifest (namespace
      dev.aarso.core_engine), merged into whichever thin :app declares android:name for the
      real dev.aarso.AarsoApp (see that app's own AndroidManifest.xml). Every class reference
      below is fully qualified (dev.aarso.*), not relative, because a relative name (".Foo")
      would resolve against THIS module's namespace (dev.aarso.core_engine) — one level off
      from where the actual moved classes still live (dev.aarso.*, unchanged by the move).
    -->
    <queries>
        <package android:name="com.termux" />
        <package android:name="io.github.mbaliga.fylz" />
        <package android:name="io.github.mbaliga.foto_xplorr" />
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="rikka.shizuku" />
    </queries>

    <application android:allowBackup="false" android:supportsRtl="true">

        <activity
            android:name="dev.aarso.ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Aarso">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- §7: content routed IN via the share sheet (text or image). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- §7: the text-selection action ("Aarso" in the selection menu). -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="dev.aarso.action.OPEN_WORKSPACE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
            </intent-filter>
        </activity>

        <activity
            android:name="dev.aarso.ui.workdeck.WorkdeckControllerActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="dev.aarso.ui.kindle.KindleSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name="dev.aarso.service.GenerationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Holds priority + shows progress while model downloads run. -->
        <service
            android:name="dev.aarso.service.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Receives Termux RUN_COMMAND PendingIntent results. Kept non-exported: the explicit
             PendingIntent is the only authority Termux receives. -->
        <service
            android:name="dev.aarso.data.runtime.TermuxResultService"
            android:exported="false" />

        <service
            android:name="dev.aarso.service.WorkdeckService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name="dev.aarso.service.WorkdeckAccessibilityService"
            android:exported="true"
            android:label="Fonebrew Workdeck input"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/workdeck_accessibility_service" />
        </service>

        <receiver
            android:name="dev.aarso.data.kindle.FylzOperationResultReceiver"
            android:exported="false" />

        <!-- §7: device assistant (assist-gesture summon). Select Aarso under
             Settings → Default apps → Digital assistant. -->
        <service
            android:name="dev.aarso.service.AarsoInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
        </service>
        <service
            android:name="dev.aarso.service.AarsoInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service
            android:name="dev.aarso.service.AarsoRecognitionService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!--
          FileProvider used by ApkInstaller (full flavor) to hand a cache-dir APK to
          the system installer via a content:// URI. Declared in main so the provider
          exists on both flavors; the install codepath is full-only (stub in play).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/fileprovider_paths" />
        </provider>
    </application>

</manifest>
