<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Egress is sanctioned for exactly two purposes (handoff §0): user-initiated
      model downloads, and opt-in cloud provider turns. Cloud is never a hidden
      default — the app defaults to on-device models, and every cloud provider is
      surfaced as a "watched object". No analytics, no telemetry.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Push-to-talk dictation only, on-device recognizer only (docs/design/voice-input.md,
         CLAUDE.md rule 1) — never the networked SpeechRecognizer, never ambient listening. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Keep the process alive while a local model loads/generates or downloads. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- §7 heavy tiers (overlay bubble, screen capture) live in the FULL flavor's
         manifest overlay — the play build ships without those permissions. -->

    <!-- Package-visibility declaration (API 30+) for the composer's Camera row (W1 — vision
         input): TakePicture launches the device's own camera app via this implicit intent; no
         CAMERA permission is declared here since the system camera app owns the hardware, not
         this app. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!--
      No android:name/icon/theme/label here — this is a library manifest (namespace
      dev.fonebrew.core_engine), merged into whichever thin :app declares android:name for the
      real dev.fonebrew.FonebrewApp (see that app's own AndroidManifest.xml). Every class reference
      below is fully qualified (dev.fonebrew.*), not relative, because a relative name (".Foo")
      would resolve against THIS module's namespace (dev.fonebrew.core_engine) — one level off
      from where the actual moved classes still live (dev.fonebrew.*, unchanged by the move).
    -->
    <application android:allowBackup="false" android:supportsRtl="true">

        <activity
            android:name="dev.fonebrew.ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Fonebrew">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- §7: content routed IN via the share sheet (text or image). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- §7: the text-selection action ("Fonebrew" in the selection menu). -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name="dev.fonebrew.service.GenerationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Holds priority + shows progress while model downloads run. -->
        <service
            android:name="dev.fonebrew.service.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          WatchBrew phone-side relay (docs/design/watchbrew.md): receives the paired watch's
          requests over the Wearable Data Layer, device-local pair transport (Bluetooth / Wi-Fi
          between the two devices) — not telemetry, nothing leaves the pair. Exported because the
          Data Layer (Play services) binds it from outside this process; the Data Layer only routes
          messages from a watch app with the SAME application id and signing key. The filter is
          scoped to the /watchbrew/ path prefix and nothing wider (the paths are
          dev.fonebrew.watchbridge.WatchPaths; a unit test keeps this filter equal to that
          contract). Reply streaming is phone -> watch over ChannelClient, so no channel filter here.
        -->
        <service
            android:name="dev.fonebrew.data.watch.WearRelayService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/watchbrew/" />
            </intent-filter>
        </service>

        <!-- §7: device assistant (assist-gesture summon). Select Fonebrew under
             Settings → Default apps → Digital assistant. -->
        <service
            android:name="dev.fonebrew.service.FonebrewInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
        </service>
        <service
            android:name="dev.fonebrew.service.FonebrewInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service
            android:name="dev.fonebrew.service.FonebrewRecognitionService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!--
          FileProvider used by ApkInstaller (full flavor) to hand a cache-dir APK to
          the system installer via a content:// URI. Declared in main so the provider
          exists on both flavors; the install codepath is full-only (stub in play).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/fileprovider_paths" />
        </provider>
    </application>

</manifest>
